# ClipGenius - Configuration
# 100% Local - Aucune clé API requise

# Dossier de sortie pour les clips générés
# OUTPUT_DIR=output

# Dossier pour les téléchargements temporaires
# DOWNLOADS_DIR=downloads

# Dossier des modèles (Phi-3, Whisper, etc.)
# MODELS_DIR=models

# Modèle Whisper à utiliser (tiny, base, small, medium, large)
# WHISPER_MODEL=base

# Nombre de threads CPU pour le LLM local (auto-detect par défaut)
# LLM_THREADS=8
