# Git Attributes for ClipGenius

# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.mp4 binary
*.mp3 binary
*.wav binary
*.webm binary
*.mov binary
*.avi binary
*.mkv binary
*.flv binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Models
*.gguf binary
*.pt binary
*.pth binary
*.onnx binary
*.bin binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.dmg binary
*.app binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
